-- values before transaction in  accounts table 
select * from accounts;
+--------+-----------------+------------+
| acc_no | acc_holder_name | amount     |
+--------+-----------------+------------+
|   1022 | Nageshwar       | 1009390.00 |
|   1023 | Lucky           |  281973.00 |
|   1024 | Himesh          |  280000.00 |
+--------+-----------------+------------+

call withdraw(1022, 1023, 500);
Query OK, 0 rows affected (0.01 sec)

